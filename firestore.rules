rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to fetch the user's role document from Firestore
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user has admin role
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Users Collection Security Rules
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read/write their own document; Admins can read/write any user document
      allow read, update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated();
      
      // User vehicles subcollection
      match /cars/{carId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Charging Stations Collection Security Rules
    // ─────────────────────────────────────────────────────────────
    match /stations/{stationId} {
      // Anyone (authenticated) can read stations
      allow read: if isAuthenticated();
      
      // ONLY users with role == 'admin' can create, update, or delete charging stations
      allow write, create, update, delete: if isAdmin();

      // Station reviews subcollection
      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
